<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Vision Companion</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is required to stream a live feed to the Vision Pro headset.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone is used for helper conversations during escalation.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Photo library access is used only when saving diagnostic frames.</string>
